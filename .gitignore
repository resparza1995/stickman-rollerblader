# ==========================================
# Unity GitHub .gitignore Template
# ==========================================

# Unity temporary and generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Android build cache
.utmp/

# Auto-generated project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.idb
*.slnx

# IDE & Editor caches
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Asset store tools
/[Aa]ssets/[Aa]sset[Ss]Store[Tt]ools*

# Builds & Packages
*.apk
*.aab
*.unitypackage

# Critical Unity rule: Always track .meta files
!/[Aa]ssets/**/*.meta

# Crash logs and dumps
*.log
*.crash
*.dll.*